{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkLog",
  "version": "0.1.0",
  "identifier": "com.gaotu.worklog",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WorkLog · 工作汇报采集",
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
